{
  "name": "adonis-template-monolith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "teo-garcia",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm docs:generate && node --env-file=.env.test.example ace build",
    "check": "pnpm lint:es:check && pnpm lint:ts && pnpm format:check && pnpm test",
    "commitlint": "commitlint --edit",
    "db:migrate": "node ace migration:run",
    "db:rollback": "node ace migration:rollback",
    "db:reset": "node ace migration:refresh",
    "db:seed": "node ace db:seed",
    "db:status": "node ace migration:status",
    "docs:generate": "node --env-file=.env.test.example ace docs:generate",
    "dev": "node ace serve --hmr",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:es": "eslint . --fix",
    "lint:es:check": "eslint .",
    "lint:staged": "lint-staged",
    "lint:ts": "tsc --noEmit",
    "prepare": "husky",
    "start": "node bin/server.js",
    "start:prod": "node build/bin/server.js",
    "test": "node --env-file=.env.test.example --env-file-if-exists=.env.test ace test",
    "test:functional": "node --env-file=.env.test.example --env-file-if-exists=.env.test ace test functional",
    "test:unit": "node --env-file=.env.test.example --env-file-if-exists=.env.test ace test unit",
    "coverage": "c8 node --env-file=.env.test.example --env-file-if-exists=.env.test ace test"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "^7.3.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@vinejs/vine": "^4.4.0",
    "adonis-autoswagger": "^3.73.0",
    "luxon": "^3.7.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.0",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.0.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@teo-garcia/eslint-config-shared": "^0.4.2",
    "@teo-garcia/prettier-config-shared": "^0.2.10",
    "@types/node": "^24.7.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.0.0",
    "hot-hook": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.0",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts",
      "./app/validators/*.ts"
    ]
  }
}
