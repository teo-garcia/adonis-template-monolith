# Application (dev default; review NODE_ENV, HOST, APP_KEY, and API_PREFIX per environment)
NODE_ENV=development
HOST=localhost
PORT=3333
HTTP_PORT=8080
APP_KEY=
APP_NAME=AdonisJS Monolith Template
APP_VERSION=1
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database (required change in production; never reuse local credentials)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=adonis_monolith
DB_DEBUG=false

# Redis (required change in production when Redis is not local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS (required change in staging/production; never use wildcard origins)
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Metrics (disable only when another telemetry path owns metrics)
METRICS_ENABLED=true

# Rate limiting (requests per TTL window, per client IP; mirrors the Nest template)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Tracing (local observability stack uses http://otel-collector:4318/v1/traces in Docker)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=adonis-template-monolith
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
